{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flowhow-test",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  // Files in public/ are served as they are; any other path reaches the Worker.
  "assets": { "directory": "./public" },
  // The remote D1 (DEPLOY §1). Local dev and tests use a local database and
  // never reach it. preview_database_id "DB" keeps the local database where
  // it was before there was a database_id (wrangler keys local state by it);
  // without it, local commands would open a new, empty one.
  "d1_databases": [
    { "binding": "DB", "database_name": "flowhow-test", "database_id": "2fd74d7a-ff48-4db5-af49-9ec71d87fc18", "preview_database_id": "DB", "migrations_dir": "migrations" }
  ]
}
