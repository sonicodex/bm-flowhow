{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flowhow-test",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  // Files in public/ are served as they are; any other path reaches the Worker.
  "assets": { "directory": "./public" },
  // No database_id: local dev and tests need none. The test database of the
  // deployment check was deleted; a remote one is created again at the next
  // deployment (wrangler d1 create).
  "d1_databases": [
    { "binding": "DB", "database_name": "flowhow-test", "migrations_dir": "migrations" }
  ]
}
