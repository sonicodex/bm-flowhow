// Checks public/js/core.js, the diagram adapter, the tour log, the grid operations and the .xlsx writer against their JSDoc
// annotations (checkJs). Not
// strict: only the functions the server uses carry types; the layout and
// tour code stay plain JavaScript.
{
  "extends": "./tsconfig.json",
  "compilerOptions": { "allowJs": true, "checkJs": true, "strict": false },
  "include": ["public/js/core.js", "public/js/diagram-layout.js", "public/js/tour-log.js", "public/js/grid-edit.js", "public/js/xlsx-write.js", "worker-configuration.d.ts"]
}
